{
  "name": "crazy-myangcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @bubble/server\" \"npm run dev -w @bubble/client\"",
    "build": "npm run build -w @bubble/client && npm run build -w @bubble/server",
    "start": "npm run start -w @bubble/server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "benchmark": "node --expose-gc --import tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
